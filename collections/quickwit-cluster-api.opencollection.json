            "url": "http://localhost:7280/api/v1/health/livez"
          },
          "docs": "Returns 200 if the node is alive."
        },
        {
          "info": {
            "name": "Readiness check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7280/api/v1/health/readyz"
          },
          "docs": "Returns 200 if the node is ready to serve requests."
