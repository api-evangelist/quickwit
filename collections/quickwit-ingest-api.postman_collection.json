    {
      "id": "584534dd-1f8d-42e5-99d5-14d70f4c884a",
      "name": "Ingest",
      "description": {
        "content": "Add documents to indexes via NDJSON format",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5b34f50d-66e8-41af-812e-70a6607654e9",
          "name": "Ingest documents",
          "request": {
            "name": "Ingest documents",
            "description": {
              "content": "Ingests NDJSON documents into an index. Each line in the request body must be a valid JSON object. The commit parameter controls when the documents become searchable.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "indexes",
                ":index_id",
                "ingest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "commit",
                  "value": "auto",
                  "description": "Controls when documents become searchable. 'auto' lets Quickwit decide, 'wait_for' waits for next commit, 'force' triggers an immediate commit.\n"
                },
                {
                  "disabled": false,
                  "key": "detailed_response",
                  "value": "false",
                  "description": "Include parse_failures in the response"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "index_id",
                  "description": "(Required) The index identifier"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-ndjson"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<string>"
            }
          },
          "response": [
            {
